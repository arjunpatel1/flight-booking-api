APP_NAME=NexDine
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false (debug leaks stack
# traces and config on error). Set APP_URL to the real HTTPS domain.
APP_ENV=local
APP_KEY=
QR_SECRET=
MEDIA_PRIVATE_DISK=local
APP_DEBUG=true
APP_URL=http://nexdine.test
ENABLE_ROUTE_DOMAIN=false
PUBLIC_DOMAIN=nexdine.test
API_DOMAIN=api.nexdine.test
SAAS_ROOT_DOMAIN=nexdine.test
SAAS_CENTRAL_DOMAINS=localhost,127.0.0.1,nexdine.test,api.nexdine.test
SAAS_REQUIRE_PLATFORM_MFA=false
SAAS_REQUIRE_TENANT_ADMIN_MFA=false
SAAS_SELF_SERVICE_ENABLED=false
SAAS_SELF_SERVICE_CAPTCHA_REQUIRED=true
SAAS_SELF_SERVICE_CAPTCHA_SECRET=
SAAS_SELF_SERVICE_DEFAULT_PLAN=starter
SAAS_SELF_SERVICE_TRIAL_DAYS=90
SAAS_ACTIVATION_TTL_MINUTES=60
SAAS_SUPPORT_HANDOFF_TTL_SECONDS=60
SAAS_SUPPORT_SESSION_MINUTES=30
SAAS_DOWNLOAD_WAITER_APP_URL=
SAAS_WAITER_APP_VERSION=
SAAS_WAITER_APP_RELEASED_AT=
SAAS_WAITER_APP_MIN_ANDROID="Android 7.0"
SAAS_WAITER_APP_SIZE=
SAAS_WAITER_APP_SHA256=
SAAS_WAITER_APP_RELEASE_NOTES=
SAAS_DOWNLOAD_WINDOWS_AGENT_URL=https://nexdine.myteknoland.in/downloads/agent/NexDine-Agent-Setup.exe
SAAS_DOWNLOAD_WINDOWS_AGENT_ENTERPRISE_URL=https://nexdine.myteknoland.in/downloads/agent/NexDine-Agent-Enterprise.zip
SAAS_WINDOWS_AGENT_VERSION=1.0.0
SAAS_WINDOWS_AGENT_RELEASED_AT=
SAAS_WINDOWS_AGENT_SIZE="292 MB"
SAAS_WINDOWS_AGENT_SHA256=da4123ea6a6011a84b2fccf12055fb0e179f4fa416b8ce6945f6f69286afd4e8
SAAS_WINDOWS_AGENT_RELEASE_NOTES=
SAAS_DOWNLOAD_KITCHEN_APP_URL=
SAAS_DOWNLOAD_OWNER_APP_URL=
SAAS_DOWNLOAD_CUSTOMER_DISPLAY_URL=

SSO_GOOGLE_ENABLED=false
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_ENABLED=false
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=common

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexdine
DB_USERNAME=root
DB_PASSWORD=
DB_ENABLE_LOG=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=nexdine-local
REVERB_APP_KEY=nexdine-local-key
REVERB_APP_SECRET=nexdine-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
REDIS_QUEUE=default
PRINT_HIGH_PRIORITY_QUEUE=printing
PRINT_RECOVERY_LIMIT=100
PRINT_STALE_LEASE_GRACE_SECONDS=10
PRINT_FAIL_STALE_PENDING_MINUTES=0
SAAS_PROVISIONING_QUEUE=provisioning
SAAS_PROVISIONING_RECOVERY_STALE_MINUTES=10
SAAS_PROVISIONING_RECOVERY_LIMIT=25
SAAS_CUSTOMER_APP_BUILD_WORKER_CONNECTED=false
SAAS_CUSTOMER_APP_BUILD_WORKER_TOKEN=
SAAS_CUSTOMER_APP_SOURCE_REPOSITORY=
SAAS_CUSTOMER_APP_SOURCE_COMMIT=
SAAS_CUSTOMER_APP_FLUTTER_VERSION=
SAAS_CUSTOMER_APP_ANDROID_SDK_VERSION=35
SAAS_CUSTOMER_APP_SIGNER_SHA256=
SAAS_CUSTOMER_APP_BUILD_SUPPORTS_AAB=false
SAAS_CUSTOMER_APP_BUILD_LEASE_SECONDS=1800
SAAS_CUSTOMER_APP_BUILD_MAX_RUNTIME_SECONDS=2400
SAAS_CUSTOMER_APP_BUILD_MAX_ATTEMPTS=3
SAAS_CUSTOMER_APP_BUILD_MAX_ACTIVE_PER_TENANT=1
SAAS_CUSTOMER_APP_BUILD_MAX_ARTIFACT_BYTES=262144000
SAAS_CUSTOMER_APP_BUILD_RETENTION_DAYS=30

CACHE_STORE=file
CACHE_ENABLED=false
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# PRODUCTION: MAIL_MAILER=log delivers nothing. Configure a real transport and
# keep provider credentials in the environment/secret store, never in source.
MAIL_MAILER=log

# Customer passwordless verification. WhatsApp uses the already configured
# notification provider/template; email uses the configured Laravel mailer.
CUSTOMER_OTP_CHANNELS=whatsapp,email
CUSTOMER_OTP_WHATSAPP_TEMPLATE=customer_login_otp
# Shared Meta webhook subscription challenge token. Generate a long random
# value in the deployment secret store and enter the same value in Meta.
WHATSAPP_META_VERIFY_TOKEN=
# NexMsg provider endpoints are fixed HTTPS destinations. Override only in an
# isolated test environment; tenant input never controls these URLs.
WHATSAPP_NEXMSG_CATALOG_SEND_URL=https://api-nexmsg.myteknoland.com/api/catalog/send
WHATSAPP_NEXMSG_CATALOG_SYNC_URL=https://api-nexmsg.myteknoland.com/api/catalog/sync
# Local/test only by default. A short-lived production UAT bypass additionally
# needs CUSTOMER_OTP_TESTING_ENABLED=true and a future expiry. Restrict this to
# a QA number only and remove the variables immediately after UAT.
# CUSTOMER_OTP_TEST_CODE=123456
# CUSTOMER_OTP_TEST_RECIPIENTS=919876543210,qa@example.test
# CUSTOMER_OTP_TESTING_ENABLED=false
# CUSTOMER_OTP_TEST_EXPIRES_AT=2026-09-03T18:30:00+05:30
CUSTOMER_OTP_TTL_MINUTES=5
CUSTOMER_OTP_RESEND_SECONDS=60
CUSTOMER_OTP_MAX_ATTEMPTS=5
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_INBOUND_DOMAIN=myteknoland.in
MAILGUN_WEBHOOK_SIGNING_KEY=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_SCHEME=https
OPENAI_API_KEY=
OPENAI_API_BASE_URI=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_SEED_DEMO_DATA=false

# Third-party delivery is off by default. Flash/uEngage production requires
# both switches plus reviewed provider contracts; credentials belong in the
# encrypted tenant settings screen, never in frontend environment files.
DELIVERY_INTEGRATION_ENABLED=false
DELIVERY_UENGAGE_SANDBOX_ENABLED=false
DELIVERY_UENGAGE_BOOKING_ENABLED=false
DELIVERY_UENGAGE_CANCELLATION_ENABLED=false
DELIVERY_UENGAGE_WEBHOOK_ENABLED=false
DELIVERY_UENGAGE_WEBHOOK_TOKEN_HASH=
DELIVERY_PROVIDER=uengage
DELIVERY_ASSIGNMENT_QUEUE=delivery
DELIVERY_UENGAGE_ENVIRONMENT=sandbox
DELIVERY_UENGAGE_PRODUCTION_ENABLED=false

# Sanctum Token Expiration (in minutes, default 1440 = 24 hours)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,chirag.nexdine.test,happy.nexdine.test,pooripool.nexdine.test,api.nexdine.test
SANCTUM_TOKEN_EXPIRATION=1440
SAAS_CUSTOMER_APP_APPLE_TEAM_ID=
